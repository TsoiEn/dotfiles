
#!/usr/bin/env bash
#
# sessionizer.sh — a telescope/lazygit-style tmux session picker
#
# Written to run on bash 3.2 (macOS's stock /bin/bash) as well as modern
# bash — no associative arrays, no bash-4+-only builtins.
#
# Backed by fzf + zoxide. Typing always filters the list (no modes). Actions
# use ctrl-combos so they never collide with typing:
#   enter    open / create the highlighted session
#   ctrl-n   new session from a typed path
#   ctrl-e   kill the session under the cursor
#   esc      quit
#
# Requires: tmux, fzf, zoxide
#
# Install:
#   cp sessionizer.sh ~/.local/bin/ts && chmod +x ~/.local/bin/ts
#   (make sure ~/.local/bin is on your PATH)
#
# Optional tmux.conf binding (e.g. prefix + f):
#   bind-key f run-shell "~/.local/bin/ts"
#
set -euo pipefail

POPUP_W="85%"
POPUP_H="80%"
POPUP_FLAG="TS_IN_POPUP"

HEADER="  enter open · ctrl-n new · ctrl-e kill · esc quit"

# ---------------------------------------------------------------------------
# Entry point / dispatch
# ---------------------------------------------------------------------------
main() {
  # --kill and --list are on the hot path (every 'e' press re-runs both via
  # execute-silent+reload), so skip the realpath resolve there — it's only
  # needed by run_picker/launch to build the self-referencing fzf binds.
  case "${1:-}" in
    --kill)  kill_session "$2"; return ;;
    --list)  build_candidates; return ;;
  esac

  self="$(realpath "${BASH_SOURCE[0]}")"

  case "${1:-}" in
    --picker) run_picker ;;
    *)        launch ;;
  esac
}

# If we're inside tmux but not already inside our own popup, re-launch
# ourselves inside a `tmux display-popup`. That popup *is* the modal.
# If we're outside tmux entirely, just run the picker right here.
launch() {
  if [[ -n "${TMUX:-}" && -z "${!POPUP_FLAG:-}" ]]; then
    tmux display-popup -E -w "$POPUP_W" -h "$POPUP_H" -T " ts " \
      env "${POPUP_FLAG}=1" "$self" --picker
  else
    run_picker
  fi
}

# ---------------------------------------------------------------------------
# The picker. Runs fzf to completion, THEN (with fzf fully exited and the
# terminal back to normal) decides what to do — nothing that needs a real
# controlling terminal (tmux attach/switch-client) ever runs while fzf still
# owns the tty.
# ---------------------------------------------------------------------------
run_picker() {
  local candidates
  candidates="$(build_candidates)"

  if [[ -z "$candidates" ]]; then
    echo "No zoxide entries yet. Run 'zoxide add <path>' or 'cd' around a bit first."
    read -n 1 -s -r -p "press any key to close"
    return
  fi

  local out status key line

  set +e
  out="$(printf '%s\n' "$candidates" | fzf \
    --ansi --delimiter '\t' --with-nth=1 \
    --prompt "  ts  " \
    --header "$HEADER" --header-first --layout=reverse --border=rounded \
    --bind "ctrl-e:execute-silent(\"$self\" --kill {3})+reload(\"$self\" --list)" \
    --expect=enter,ctrl-n)"
  status=$?
  set -e

  # esc / ctrl-c / no match -> just close the modal
  [[ $status -ne 0 || -z "$out" ]] && return 0

  key="$(sed -n '1p' <<< "$out")"
  line="$(sed -n '2p' <<< "$out")"

  if [[ "$key" == "ctrl-n" ]]; then
    new_session_prompt
    return
  fi

  [[ -z "$line" ]] && return 0
  open_line "$line"
}

build_candidates() {
  local sessions dirs s d name sessions_nl

  sessions="$(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)"
  # Newline-delimited, newline-padded so a plain glob-pattern containment
  # check below can do an exact per-line match — no associative arrays
  # (bash 3.2, which macOS ships as /bin/bash, doesn't support declare -A)
  # and no subprocess spawn per directory.
  sessions_nl=$'\n'"$sessions"$'\n'

  if [[ -n "$sessions" ]]; then
    while IFS= read -r s; do
      [[ -z "$s" ]] && continue
      printf ' ● %s (session)\tsession\t%s\n' "$s" "$s"
    done <<< "$sessions"
  fi

  # Pure-bash basename/tr equivalents below (no subprocess per line) — with
  # a large zoxide history, forking basename/tr/grep for every entry is the
  # main reason this used to feel slow, especially on every session-kill
  # reload.
  dirs="$(zoxide query -l 2>/dev/null || true)"
  if [[ -n "$dirs" ]]; then
    while IFS= read -r d; do
      [[ -z "$d" || ! -d "$d" ]] && continue
      name="${d##*/}"
      name="${name//./_}"
      [[ "$sessions_nl" == *$'\n'"$name"$'\n'* ]] && continue
      printf '   %s\tdir\t%s\n' "$d" "$d"
    done <<< "$dirs"
  fi
}

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

open_line() {
  local line="$1" type value path session_name
  type="$(cut -f2 <<< "$line")"
  value="$(cut -f3 <<< "$line")"

  if [[ "$type" == "session" ]]; then
    session_name="$value"
  else
    path="$value"
    session_name="$(basename "$path" | tr . _)"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      tmux new-session -d -s "$session_name" -c "$path"
    fi
  fi

  attach_or_switch "$session_name"
}

# Called only after fzf has fully exited, so tmux always has a real
# controlling terminal to work with here.
attach_or_switch() {
  local session_name="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$session_name"
  else
    tmux attach -t "=$session_name"
  fi
}

new_session_prompt() {
  local path
  path="$(tmux display-popup -E -w 60 -h 3 -T " new session: path " \
    bash -c 'read -r -p "path> " p; echo "$p"')"
  [[ -z "$path" ]] && return 0
  path="${path/#\~/$HOME}"
  if [[ ! -d "$path" ]]; then
    tmux display-popup -E -w 50 -h 3 -T " error " \
      bash -c "echo 'no such directory: $path'; read -n1 -s -r"
    return 0
  fi
  local session_name
  session_name="$(basename "$path" | tr . _)"
  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -d -s "$session_name" -c "$path"
  fi
  attach_or_switch "$session_name"
}

kill_session() {
  local name="$1"
  [[ -z "$name" ]] && return 0
  tmux kill-session -t "=$name" 2>/dev/null || true
}

main "$@"
